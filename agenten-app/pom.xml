<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.zuluindustries</groupId>
        <artifactId>agenten-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agenten-app</artifactId>
    <name>Agentenplattform – Anwendung</name>
    <description>Ausführbare JAR: Kern plus alle Fachmodule. Ein Modul wird durch Entfernen seiner
        Abhängigkeit abgeschaltet.</description>

    <properties>
        <main.class>com.zuluindustries.agenten.cli.Main</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.zuluindustries</groupId>
            <artifactId>agenten-core</artifactId>
        </dependency>
        <!-- B2B-Verfügbarkeitsmonitor: derzeit abgeschaltet. Zum Einbinden den Kommentar entfernen.
        <dependency>
            <groupId>com.zuluindustries</groupId>
            <artifactId>agenten-monitor</artifactId>
        </dependency>
        -->
    </dependencies>

    <build>
        <finalName>agenten-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <manifestEntries>
                                        <!-- sqlite-jdbc lädt eine native Bibliothek -->
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                                <!-- Führt die PlatformExtension-Einträge aller Module zusammen. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
